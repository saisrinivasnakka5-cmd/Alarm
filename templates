<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mess Meal Alarm</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
  <main class="page">
    <header class="hero">
      <div class="brand-icon">🍽️</div>
      <p class="eyebrow">YOUR DAILY ROUTINE</p>
      <h1>Mess Meal Alarm</h1>
      <p class="subtitle">Never miss breakfast, lunch, or dinner.</p>
      <div class="clock-panel">
        <div id="currentTime" class="current-time">--:--:--</div>
        <div id="currentDate" class="current-date">Loading date…</div>
        <div class="alarm-status"><span class="status-dot"></span><span id="statusText">Reminders are ready</span></div>
      </div>
    </header>

    <section class="controls">
      <div>
        <h2>Meal reminders</h2>
        <p class="section-note">Set your mess timings and turn reminders on or off.</p>
      </div>
      <button id="enableNotifications" class="notify-btn" type="button">🔔 Enable alerts</button>
    </section>

    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}
        {% for category, message in messages %}
          <div class="flash {{ category }}">{{ message }}</div>
        {% endfor %}
      {% endif %}
    {% endwith %}

    <section class="meal-grid">
      {% for meal in meals %}
      <article class="meal-card {{ meal.name|lower }}">
        <div class="meal-top">
          <div class="meal-emoji">
            {% if meal.name == 'Breakfast' %}🌅{% elif meal.name == 'Lunch' %}☀️{% else %}🌙{% endif %}
          </div>
          <span class="meal-tag">{{ meal.name }}</span>
        </div>
        <h3>{{ meal.name }}</h3>
        <p class="meal-description">
          {% if meal.name == 'Breakfast' %}Start your day with a good meal.
          {% elif meal.name == 'Lunch' %}Take a break and recharge.
          {% else %}Finish your day with dinner.{% endif %}
        </p>
        <form method="post" class="meal-form">
          <input type="hidden" name="meal_id" value="{{ meal.id }}">
          <label for="time-{{ meal.id }}">Meal time</label>
          <input id="time-{{ meal.id }}" name="meal_time" type="time" value="{{ meal.meal_time }}" required>
          <label class="toggle-row">
            <span>Reminder enabled</span>
            <input type="checkbox" name="enabled" {% if meal.enabled %}checked{% endif %}>
            <span class="toggle-ui"></span>
          </label>
          <button class="save-btn" type="submit">Save timing</button>
        </form>
        <div class="countdown">
          <span class="countdown-label">NEXT REMINDER</span>
          <strong id="countdown-{{ meal.id }}">Calculating…</strong>
        </div>
      </article>
      {% endfor %}
    </section>

    <section class="tip">
      <span class="tip-icon">💡</span>
      <div><strong>Keep this page open for alarms</strong><p>Browser alerts and sound work while this page is open. Allow notifications when prompted and keep your device volume on.</p></div>
    </section>
    <footer>Made for your campus mess routine · Meal times are saved on this server.</footer>
  </main>
  <script>
    const meals = {{ meals | tojson }};
    const fired = new Set();

    function updateClock() {
      const now = new Date();
      document.getElementById('currentTime').textContent =
        now.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit', second: '2-digit'});
      document.getElementById('currentDate').textContent =
        now.toLocaleDateString([], {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'});
      meals.forEach(meal => {
        const el = document.getElementById('countdown-' + meal.id);
        if (!el) return;
        if (!meal.enabled) { el.textContent = 'Reminder is off'; return; }
        const [hours, minutes] = meal.meal_time.split(':').map(Number);
        const target = new Date();
        target.setHours(hours, minutes, 0, 0);
        if (target <= now) target.setDate(target.getDate() + 1);
        const seconds = Math.floor((target - now) / 1000);
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = seconds % 60;
        el.textContent = `${h}h ${m}m ${s}s`;
        const key = `${meal.id}-${now.toDateString()}-${now.getHours()}:${now.getMinutes()}`;
        if (meal.enabled && now.getHours() === hours && now.getMinutes() === minutes && !fired.has(key)) {
          fired.add(key);
          triggerAlarm(meal.name);
        }
      });
    }

    function triggerAlarm(mealName) {
      document.getElementById('statusText').textContent = `${mealName} time!`;
      try {
        const audio = new Audio('data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=');
        audio.play().catch(() => {});
      } catch (e) {}
      // Short audible tone using Web Audio API, if the browser allows it.
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.frequency.value = 880; gain.gain.value = 0.18;
        osc.start();
        setTimeout(() => { osc.stop(); ctx.close(); }, 900);
      } catch (e) {}
      if ('Notification' in window && Notification.permission === 'granted') {
        new Notification(`${mealName} time 🍽️`, {body: `It's time for ${mealName.toLowerCase()} at the mess.`});
      }
      alert(`🍽️ ${mealName} time! Head to the mess.`);
    }

    document.getElementById('enableNotifications').addEventListener('click', async () => {
      if (!('Notification' in window)) {
        alert('This browser does not support notifications. Keep this page open to use the on-screen alarm.');
        return;
      }
      const permission = await Notification.requestPermission();
      document.getElementById('statusText').textContent =
        permission === 'granted' ? 'Browser alerts enabled' : 'Alerts not permitted';
      if (permission === 'granted') new Notification('Mess Meal Alarm', {body: 'Meal reminders are enabled.'});
    });

    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>